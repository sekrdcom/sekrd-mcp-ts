{
  "name": "@sekrd/mcp-server",
  "version": "0.1.0",
  "description": "MCP server for Sekrd — security scanning from AI IDEs",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sekrd-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { chmodSync } from 'node:fs'; chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sekrdcom/sekrd-mcp-ts.git"
  },
  "homepage": "https://sekrd.com",
  "bugs": {
    "url": "https://github.com/sekrdcom/sekrd-mcp-ts/issues"
  },
  "keywords": [
    "mcp",
    "security",
    "scanner",
    "sekrd",
    "supabase",
    "firebase",
    "cursor",
    "claude"
  ]
}
